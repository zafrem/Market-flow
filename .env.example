# Copy to .env (never commit .env)
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=marketflow
MYSQL_USER=marketflow
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306
MOCK_LLM=true
# KAMIS (https://www.kamis.or.kr open API)
KAMIS_API_KEY=
KAMIS_API_ID=
# Garak endpoint (see src/marketflow/collectors/garak.py for the assumed schema)
GARAK_API_URL=
GARAK_API_KEY=

# API / dashboard (required): python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
API_PORT=8000
TOKEN_TTL_MINUTES=60
# Slack-compatible webhook for alerts (optional; use a channel only MD/ADMIN can read)
ALERT_WEBHOOK_URL=
GEMINI_API_KEY=
